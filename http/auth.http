@baseUrl=http://localhost:8000/api/v1/auth

### register
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "adam",
  "email": "adam@apple.seed",
  "password": "12345678"
}

### login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "adam@apple.seed",
  "password": "12345678"
}

### verify email
GET {{baseUrl}}/verify-email?token=TOKEN_FROM_EMAIL

### resend verification email
POST {{baseUrl}}/resend-verification
Content-Type: application/json

{
  "email": "adam@apple.seed"
}