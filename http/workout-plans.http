@baseUrl=http://localhost:8000/api/v1

@emailA=hhgiang2000@gmail.com
@passwordA=12345678

@emailB=adam@apple.seed
@passwordB=12345678


############################################
# Login as User A
############################################

# @name loginA
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{emailA}}",
  "password": "{{passwordA}}"
}

###

@accessTokenA={{loginA.response.body.$.tokens.accessToken}}


############################################
# 1. Reject unauthenticated requests
# Expected: 401
############################################

GET {{baseUrl}}/workout-plans


############################################
# 2. Create workout plan
# Expected: 201
############################################

# @name createPlan
POST {{baseUrl}}/workout-plans
Content-Type: application/json
Authorization: Bearer {{accessTokenA}}

{
  "name": "Push Pull Legs",
  "description": "My first workout plan",
  "isActive": true,
  "days": [
    {
      "name": "Push Day",
      "exercises": []
    },
    {
      "name": "Pull Day",
      "exercises": []
    },
    {
      "name": "Leg Day",
      "exercises": []
    }
  ]
}

###

@workoutPlanId={{createPlan.response.body.$.data._id}}


############################################
# 3. List User A's plans
# Expected: 200
############################################

GET {{baseUrl}}/workout-plans
Authorization: Bearer {{accessTokenA}}


############################################
# 4. Get plan by ID
# Expected: 200
############################################

GET {{baseUrl}}/workout-plans/{{workoutPlanId}}
Authorization: Bearer {{accessTokenA}}


############################################
# 5. PATCH only the name
# Expected: 200
############################################

PATCH {{baseUrl}}/workout-plans/{{workoutPlanId}}
Content-Type: application/json
Authorization: Bearer {{accessTokenA}}

{
  "name": "Updated Push Pull Legs"
}


############################################
# 6. Confirm PATCH did not erase days
# Expected:
# - name is updated
# - days still contains 3 days
# - isActive remains true
############################################

GET {{baseUrl}}/workout-plans/{{workoutPlanId}}
Authorization: Bearer {{accessTokenA}}


############################################
# 7. Reject an empty PATCH
# Expected: 400
############################################

PATCH {{baseUrl}}/workout-plans/{{workoutPlanId}}
Content-Type: application/json
Authorization: Bearer {{accessTokenA}}

{}


############################################
# 8. Reject invalid targetSets
# Expected: 400
############################################

POST {{baseUrl}}/workout-plans
Content-Type: application/json
Authorization: Bearer {{accessTokenA}}

{
  "name": "Invalid plan",
  "days": [
    {
      "name": "Day One",
      "exercises": [
        {
          "exerciseId": "000000000000000000000001",
          "targetSets": 0,
          "targetReps": 10
        }
      ]
    }
  ]
}


############################################
# 9. Reject decimal targetReps
# Expected: 400
############################################

POST {{baseUrl}}/workout-plans
Content-Type: application/json
Authorization: Bearer {{accessTokenA}}

{
  "name": "Invalid decimal reps",
  "days": [
    {
      "name": "Day One",
      "exercises": [
        {
          "exerciseId": "000000000000000000000001",
          "targetSets": 3,
          "targetReps": 8.5
        }
      ]
    }
  ]
}


############################################
# 10. Reject client-supplied userId
# Expected: 400
############################################

POST {{baseUrl}}/workout-plans
Content-Type: application/json
Authorization: Bearer {{accessTokenA}}

{
  "name": "Invalid ownership plan",
  "userId": "000000000000000000000001",
  "days": []
}


############################################
# 11. Reject invalid workout-plan ID
# Expected: 400
############################################

GET {{baseUrl}}/workout-plans/not-a-valid-id
Authorization: Bearer {{accessTokenA}}


############################################
# Login as User B
############################################

# @name loginB
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{emailB}}",
  "password": "{{passwordB}}"
}

###

@accessTokenB={{loginB.response.body.$.tokens.accessToken}}


############################################
# 12. User B cannot read User A's plan
# Expected: 404
############################################

GET {{baseUrl}}/workout-plans/{{workoutPlanId}}
Authorization: Bearer {{accessTokenB}}


############################################
# 13. User B cannot update User A's plan
# Expected: 404
############################################

PATCH {{baseUrl}}/workout-plans/{{workoutPlanId}}
Content-Type: application/json
Authorization: Bearer {{accessTokenB}}

{
  "name": "Stolen plan"
}


############################################
# 14. User B cannot delete User A's plan
# Expected: 404
############################################

DELETE {{baseUrl}}/workout-plans/{{workoutPlanId}}
Authorization: Bearer {{accessTokenB}}


############################################
# 15. User A can delete their own plan
# Expected: 204
############################################

DELETE {{baseUrl}}/workout-plans/{{workoutPlanId}}
Authorization: Bearer {{accessTokenA}}


############################################
# 16. Deleted plan is no longer retrievable
# Expected: 404
############################################

GET {{baseUrl}}/workout-plans/{{workoutPlanId}}
Authorization: Bearer {{accessTokenA}}


############################################
# 17. Deleted plan is absent from list
# Expected: 200, without the deleted plan
############################################

GET {{baseUrl}}/workout-plans
Authorization: Bearer {{accessTokenA}}